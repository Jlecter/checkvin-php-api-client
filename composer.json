{
    "name": "jlecter/checkvin-php-api-client",
    "description": "Package for working with CheckVin API",
    "license": "MIT",
    "authors": [
        {
            "name": "Illia Radchenko",
            "email": "fifa.leicester.city@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CheckVin\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CheckVin\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
